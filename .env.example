# Create app credentials in the GitHub Actions or hosting platform secret store.
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=replace_me
# Use different strong keys. ADMIN key can create docs and manage access.
ADMIN_API_KEY=replace_with_random_32_plus_characters
WRITE_API_KEY=replace_with_another_random_32_plus_characters
BIND_ADDR=0.0.0.0:3000
DATA_FILE=/data/documents.json
LARK_API_BASE=https://open.feishu.cn/open-apis
LARK_DOC_BASE=https://your-tenant.feishu.cn
