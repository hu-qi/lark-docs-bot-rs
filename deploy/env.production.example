# Copy to project root as .env.production (never commit real keys).
# Point DNS A/AAAA records for this hostname to your container host first.
SITE_DOMAIN=docs.example.com
ACME_EMAIL=admin@example.com
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace_with_secret
ADMIN_API_KEY=replace_with_distinct_random_value_of_at_least_32_chars
WRITE_API_KEY=replace_with_another_distinct_random_value_32_chars
LARK_DOC_BASE=https://www.feishu.cn
LARK_API_BASE=https://open.feishu.cn/open-apis
BIND_ADDR=0.0.0.0:3000
DATA_FILE=/data/documents.json
READ_LIMIT_PER_MINUTE=120
WRITE_LIMIT_PER_MINUTE=30
RUST_LOG=info
